// Public deployment trust pins. Only the internal pilot bearer belongs in the
// ignored LiveTalk.local.xcconfig. Keeping the broker and LiveKit host here
// prevents a release archive from silently losing its non-secret routing.
OPENCLAM_LIVETALK_BROKER_URL = https:/$()/openclam-livekit-pilot-broker.openclam-live.workers.dev/v1/live-talk/sessions
OPENCLAM_LIVETALK_APP_TOKEN =
OPENCLAM_LIVETALK_EXPECTED_SERVER_HOST = openclam-live-voice-kse86f6p.livekit.cloud

#include "AgentConnector.xcconfig"
#include? "LiveTalk.local.xcconfig"
