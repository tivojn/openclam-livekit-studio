// Independent OpenClam Agent Connector bridge. Put the exact HTTPS origin in
// AgentConnector.local.xcconfig, which is gitignored. Xcode treats // as a
// comment delimiter, so write the scheme separator as /$()/, for example:
// OPENCLAM_AGENT_CONNECTOR_ORIGIN = https:/$()/bridge.example.com
// Origins with paths, credentials, queries, fragments, redirects, or non-HTTPS
// schemes are rejected.
OPENCLAM_AGENT_CONNECTOR_ORIGIN =

#include? "AgentConnector.local.xcconfig"
