{
  "name": "openclam-livekit-studio",
  "version": "1.0.9",
  "author": "OpenClam contributors",
  "license": "MIT",
  "private": true,
  "description": "Standalone OpenClam chat, push-to-talk, LiveKit voice, and avatar studio for Apple Silicon Macs",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/tivojn/openclam-livekit-studio.git"
  },
  "bugs": {
    "url": "https://github.com/tivojn/openclam-livekit-studio/issues"
  },
  "homepage": "https://github.com/tivojn/openclam-livekit-studio#readme",
  "scripts": {
    "prestart": "npm run stage:livekit && npm run fetch:model && npm run build:native",
    "start": "electron .",
    "predev": "npm run stage:livekit && npm run fetch:model && npm run build:native",
    "dev": "electron .",
    "build:cutout": "scripts/build-person-cutout.sh",
    "build:native": "npm run build:cutout",
    "stage:livekit": "node scripts/stage-livekit-assets.mjs",
    "pretest": "npm run stage:livekit",
    "test": ".venv/bin/python -m unittest discover -s tests -v && node qa/track_qa.js && node qa/pet_window_bounds_qa.js && node qa/pet_window_level_qa.js && node qa/avatar_store_qa.js && node qa/standalone_shell_qa.js && node qa/openclam_desktop_renderer_qa.js && node qa/openclam_settings_qa.js && node qa/codex_macos_theme_qa.js && node qa/menu_accessibility_qa.js && node qa/release_security_qa.js",
    "check:syntax": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/avatar-store.cjs && node --check electron/bubble-preload.cjs && node --check electron/appearance-preload.cjs && node --check electron/menu-preload.cjs && node --check electron/pet-window-bounds.cjs && node --check electron/pet-window-level.cjs && node --check qa/life_probe.js && node --check qa/track_qa.js && node --check qa/pet_window_bounds_qa.js && node --check qa/pet_window_level_qa.js && node --check qa/avatar_store_qa.js && node --check qa/standalone_shell_qa.js && node --check qa/openclam_desktop_renderer_qa.js && node --check qa/openclam_settings_qa.js && node --check qa/codex_macos_theme_qa.js && node --check qa/menu_accessibility_qa.js && node --check qa/release_security_qa.js && /bin/bash -n scripts/release-macos.sh && /bin/bash -n scripts/stage-openclaw-plugin.sh && node scripts/check-inline-scripts.mjs && .venv/bin/python -m compileall -q server studio tests scripts qa",
    "check:native": "scripts/build-person-cutout.sh --check",
    "check:privacy": ".venv/bin/python scripts/public-release-audit.py .",
    "check:avatar": "node qa/life_probe.js . check && .venv/bin/python -W ignore qa/blink_lash_qa.py && .venv/bin/python -W ignore qa/mouth_motion_qa.py",
    "check": "npm run check:syntax && npm run check:native && npm test && npm run check:privacy",
    "fetch:model": "scripts/fetch-face-model.sh",
    "stage:python": "scripts/stage-electron-python.sh",
    "stage:site-packages": "scripts/stage-electron-site-packages.sh",
    "stage:ffmpeg": "scripts/stage-electron-ffmpeg.sh",
    "stage:openclaw": "scripts/stage-openclaw-plugin.sh",
    "stage:backend": "npm run stage:python && npm run stage:site-packages && npm run stage:ffmpeg && scripts/stage-electron-python.sh --scrub-only",
    "pack": "npm run stage:livekit && npm run fetch:model && npm run build:native && npm run stage:backend && npm run stage:openclaw && electron-builder --mac dir",
    "dist": "scripts/release-macos.sh"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lionheart.openclam.macos",
    "productName": "OpenClam Studio",
    "asar": true,
    "forceCodeSigning": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!electron/native/**",
      "!node_modules/**/src/**",
      "!node_modules/**/*.map",
      "!node_modules/livekit-client/src/test/**",
      "!node_modules/livekit-client/src/**/__snapshots__/**",
      "!node_modules/livekit-client/src/**/*.test.ts",
      "!node_modules/livekit-client/src/room/token-source/test-tokens.ts",
      "!node_modules/livekit-client/dist/src/test/**",
      "!node_modules/livekit-client/dist/ts4.2/test/**",
      "!node_modules/@livekit/mutex/src/index.test.ts",
      "!node_modules/@livekit/mutex/dist/index.test.d.ts",
      "!node_modules/@livekit/mutex/dist/index.test.d.ts.map"
    ],
    "extraResources": [
      {
        "from": ".electron-python-runtime",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/.DS_Store"
        ]
      },
      {
        "from": ".electron-site-packages",
        "to": "python/lib/python3.12/site-packages",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store",
          "!torch/bin/**",
          "!torch/include/**",
          "!torch/share/**",
          "!**/tests/**",
          "!**/test/**",
          "!**/conftest.py",
          "!**/pytest_plugin.py",
          "!absl/testing/**",
          "!aiohttp/test_utils.py",
          "!annotated_types/test_cases.py",
          "!click/testing.py",
          "!matplotlib/testing/**",
          "!mediapipe/tasks/python/genai/**/*_test.py",
          "!networkx/conftest.py",
          "!numba/core/datamodel/testing.py",
          "!numba/cuda/testing.py",
          "!numba/runtests.py",
          "!numba/testing/**",
          "!numpy/_core/*_tests.cpython-*.so",
          "!scipy/**/_test*.cpython-*.so",
          "!setuptools/command/test.py",
          "!sympy/testing/**",
          "!sympy/utilities/pytest.py",
          "!sympy/utilities/runtests.py",
          "!sympy/utilities/tmpfiles.py",
          "!**/*.pyi",
          "!**/examples/**",
          "!**/benchmarks/**",
          "!functorch/**",
          "!isympy.py",
          "!torch/**",
          "!torch-*.dist-info/**",
          "!torchgen/**"
        ]
      },
      {
        "from": "server",
        "to": "backend/server",
        "filter": [
          "**/*.py",
          "!**/build_sprites.py"
        ]
      },
      {
        "from": "studio",
        "to": "backend/studio",
        "filter": [
          "**/*.py",
          "!blink_qa.py",
          "!life_qa.py"
        ]
      },
      {
        "from": "web",
        "to": "backend/web",
        "filter": [
          "index.html",
          "settings.html",
          "bubble.html",
          "menu.html",
          "appearance.html",
          "live-worklet.js",
          "assets/sf-symbols/*.png",
          "vendor/livekit-client.umd.js",
          "vendor/live-talk-connection.wav"
        ]
      },
      {
        "from": "contracts",
        "to": "backend/contracts",
        "filter": [
          "live-talk-approved-tuples-v1.json",
          "avatar-package-v2/README.md",
          "avatar-package-v2/manifest.schema.json",
          "avatar-package-v2/macos-full.schema.json",
          "avatar-package-v2/ios-light-v3.schema.json",
          "avatar-package-v2/ios-full-expression-v4.schema.json"
        ]
      },
      {
        "from": ".electron-ffmpeg",
        "to": "backend/bin",
        "filter": [
          "ffmpeg",
          "ffprobe",
          "LICENSE.LGPLv2.1.txt"
        ]
      },
      {
        "from": ".electron-models",
        "to": "backend/models"
      },
      {
        "from": ".electron-native/person-cutout",
        "to": "native/person-cutout"
      },
      {
        "from": ".electron-openclaw-plugin",
        "to": "openclaw",
        "filter": [
          "openclam-channel.tgz",
          "install-config.json"
        ]
      },
      {
        "from": "LICENSE",
        "to": "docs/LICENSE.txt"
      },
      {
        "from": "PRIVACY.md",
        "to": "docs/PRIVACY.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "docs/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSES",
        "to": "docs/LICENSES",
        "filter": [
          "*.md",
          "*.txt",
          "*.json"
        ]
      },
      {
        "from": "requirements-electron.txt",
        "to": "docs/runtime/requirements-electron.txt"
      },
      {
        "from": "requirements-electron.lock",
        "to": "docs/runtime/requirements-electron.lock"
      },
      {
        "from": "package-lock.json",
        "to": "docs/runtime/package-lock.json"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "THE GREAT LIONHEART PTE. LTD. (X7R8N6MMSU)",
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "LSMinimumSystemVersion": "14.0",
        "NSMicrophoneUsageDescription": "OpenClam Studio uses the microphone only while you hold push-to-talk or place a Live Talk call; hanging up stops capture.",
        "NSCameraUsageDescription": "OpenClam Studio uses the camera only when you choose Take a Photo in the chat composer."
      }
    },
    "dmg": {
      "title": "OpenClam Studio ${version}",
      "artifactName": "OpenClam-Studio-${version}-${arch}.${ext}",
      "format": "UDBZ"
    }
  },
  "dependencies": {
    "livekit-client": "2.21.0"
  }
}
