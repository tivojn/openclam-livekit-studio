# Copy to .dev.vars for local development. Never commit .dev.vars.
LIVEKIT_API_KEY="replace-with-local-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-local-livekit-api-secret"

# 32 random bytes, standard base64. Example generation:
# openssl rand -base64 32
BYOK_KEK_B64="replace-with-32-byte-base64-key"

# Separate secrets for the iOS pilot and the deployed LiveKit agent.
PILOT_APP_TOKEN="replace-with-long-random-pilot-token"
OPENCLAM_BROKER_AGENT_TOKEN="replace-with-long-random-agent-token"
