# LiveKit Cloud deployment injects its own project credentials.
OPENCLAM_BROKER_URL=https://openclam-livekit-pilot-broker.example.workers.dev
OPENCLAM_BROKER_AGENT_TOKEN=replace-with-at-least-32-random-characters

# Never put a user's provider key here. BYOK credentials arrive through a
# one-use encrypted lease and live only in the isolated job process.
