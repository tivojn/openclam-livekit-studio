{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openclam:avatar-store:v1:catalog-schema",
  "title": "OpenClam Avatar Store Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "bytes", "mime", "width", "height"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsURL" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "mime": { "const": "image/png" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "iosPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "bytes", "format", "profile"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsURL" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "format": { "const": "openclam-avatar" },
        "profile": { "const": "ios-light" }
      }
    },
    "macPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "bytes", "format", "profile"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsURL" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "format": { "const": "openclam-avatar" },
        "profile": { "const": "macos-full" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "author", "version", "thumbnail", "variants"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "thumbnail": { "$ref": "#/$defs/thumbnail" },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ios-light"],
          "properties": {
            "ios-light": { "$ref": "#/$defs/iosPackage" },
            "macos-full": { "$ref": "#/$defs/macPackage" }
          }
        }
      }
    }
  }
}
