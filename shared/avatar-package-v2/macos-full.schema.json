{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclam.app/schemas/avatar-package-v2-macos-full.json",
  "title": "OpenClam Avatar Package v2 (macos-full)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "variant", "id", "displayName", "status",
    "capabilities", "files"
  ],
  "properties": {
    "format": { "const": "openclam-avatar" },
    "version": { "const": 2 },
    "variant": { "const": "macos-full" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": ["draft", "building", "ready", "failed"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "fullBody", "walk", "edgeIdle", "moves"],
      "properties": {
        "head": { "type": "boolean" },
        "fullBody": { "type": "boolean" },
        "walk": { "type": "boolean" },
        "edgeIdle": { "type": "boolean" },
        "moves": { "type": "boolean" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteCount", "mediaType"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 12,
          "maxLength": 1024,
          "pattern": "^authoring/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
        }
      }
    }
  }
}
